      "id": "q-math-1",
      "createdBy": "usr-teacher-1",
      "questionText": "If a 2x2 real matrix A has eigenvalues 3 and 5, what is the determinant of A?",
      "questionType": "mcq",
      "subject": "Mathematics",
      "topic": "Linear Algebra",
      "category": "Quiz",
      "difficulty": "easy",
      "options": [
        {
          "id": "opt-a",
          "text": "15"
        },
        {
          "id": "opt-b",
          "text": "8"
        },
        {
          "id": "opt-c",
          "text": "2"
        },
        {
          "id": "opt-d",
          "text": "34"
        }
      ],
      "correctAnswer": "opt-a",
      "marks": 5,
      "negativeMarks": 0,
      "explanation": "The determinant of a matrix equals the product of its eigenvalues (3 * 5 = 15).",
      "createdAt": "2026-11-06T18:46:26.569Z",
      "updatedAt": "2026-11-06T18:46:26.569Z"
    },
    {
