    {
      "id": "q-cs-7",
      "createdBy": "usr-teacher-1",
      "questionText": "In ACID database transactions, what does Isolation guarantee?",
      "questionType": "mcq",
      "subject": "Database Systems",
      "topic": "Transactions",
      "category": "Databases",
      "difficulty": "medium",
      "options": [
        {
          "id": "opt-a",
          "text": "Concurrent transactions execute without interfering with each other’s intermediate state"
        },
        {
          "id": "opt-b",
          "text": "Committed data survives power loss"
        },
        {
          "id": "opt-c",
          "text": "All statements succeed or all roll back together"
        },
        {
          "id": "opt-d",
          "text": "Schema foreign keys are always indexed"
        }
      ],
      "correctAnswer": "opt-a",
      "marks": 5,
      "negativeMarks": 1,
      "explanation": "Isolation ensures concurrent execution leaves the database in the same state as serial execution.",
      "createdAt": "2026-10-28T18:46:26.569Z",
      "updatedAt": "2026-10-28T18:46:26.569Z"
    },
    {
      "id": "q-cs-8",
      "createdBy": "usr-teacher-1",
      "questionText": "Which MongoDB practices protect an Express API from NoSQL operator injection?",
      "questionType": "multi_select",
      "subject": "Database Systems",
      "topic": "Query Security",
      "category": "Databases",
      "difficulty": "medium",
      "options": [
        {
          "id": "opt-a",
          "text": "Validate request payload types with Zod or schema validators"
        },
        {
          "id": "opt-b",
          "text": "Strip keys beginning with $ or containing dots from untrusted input"
        },
        {
          "id": "opt-c",
          "text": "Pass raw req.body directly into Model.findOne()"
        },
        {
          "id": "opt-d",
          "text": "Use explicit field projection and allowlists"
        }
      ],
      "correctAnswer": [
        "opt-a",
        "opt-b",
        "opt-d"
      ],
      "marks": 5,
      "negativeMarks": 1,
      "explanation": "Strict schema validation, operator stripping, and explicit allowlists block $ne/$gt injection.",
      "createdAt": "2026-10-29T18:46:26.569Z",
      "updatedAt": "2026-10-29T18:46:26.569Z"
    },
