      "id": "q-ee-1",
      "createdBy": "usr-teacher-2",
      "questionText": "According to the Nyquist-Shannon sampling theorem, to avoid aliasing a band-limited signal with maximum frequency f_max, the sampling rate f_s must satisfy:",
      "questionType": "mcq",
      "subject": "Electrical Engineering",
      "topic": "Sampling Theory",
      "category": "Signal Processing",
      "difficulty": "easy",
      "options": [
        {
          "id": "opt-a",
          "text": "f_s > 2 · f_max"
        },
        {
          "id": "opt-b",
          "text": "f_s = f_max / 2"
        },
        {
          "id": "opt-c",
          "text": "f_s < f_max"
        },
        {
          "id": "opt-d",
          "text": "f_s = f_max"
        }
      ],
      "correctAnswer": "opt-a",
      "marks": 5,
      "negativeMarks": 1,
      "explanation": "Sampling strictly above twice the highest frequency component prevents spectral overlap.",
      "createdAt": "2026-11-02T18:46:26.569Z",
      "updatedAt": "2026-11-02T18:46:26.569Z"
    },
