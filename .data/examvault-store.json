  "questions": [
    {
      "id": "q-cs-1",
      "createdBy": "usr-teacher-1",
      "questionText": "What is the worst-case time complexity of searching an element in a balanced AVL tree with n nodes?",
      "questionType": "mcq",
      "subject": "Computer Science",
      "topic": "Balanced Trees",
      "category": "Data Structures",
      "difficulty": "easy",
      "options": [
        {
          "id": "opt-a",
          "text": "O(log n)"
        },
        {
          "id": "opt-b",
          "text": "O(n)"
        },
        {
          "id": "opt-c",
          "text": "O(n log n)"
        },
        {
          "id": "opt-d",
          "text": "O(1)"
        }
      ],
      "correctAnswer": "opt-a",
      "marks": 4,
      "negativeMarks": 1,
      "explanation": "AVL trees maintain a strict height balance factor of -1, 0, or +1, guaranteeing height O(log n).",
      "createdAt": "2026-10-17T18:46:26.569Z",
      "updatedAt": "2026-10-17T18:46:26.569Z"
    },
    {
      "id": "q-cs-2",
      "createdBy": "usr-teacher-1",
      "questionText": "Which of the following HTTP response cookie flags help mitigate cross-site scripting (XSS) and CSRF token theft?",
      "questionType": "multi_select",
      "subject": "Computer Science",
      "topic": "Web Security",
      "category": "Application Security",
      "difficulty": "medium",
      "options": [
        {
          "id": "opt-a",
          "text": "HttpOnly"
        },
        {
          "id": "opt-b",
          "text": "Secure"
        },
        {
          "id": "opt-c",
          "text": "SameSite"
        },
        {
          "id": "opt-d",
          "text": "X-Powered-By"
        }
      ],
      "correctAnswer": [
        "opt-a",
        "opt-b",
        "opt-c"
      ],
      "marks": 6,
      "negativeMarks": 1.5,
      "explanation": "HttpOnly blocks client JS access, Secure enforces HTTPS transit, and SameSite governs cross-site dispatch.",
      "createdAt": "2026-10-19T18:46:26.569Z",
      "updatedAt": "2026-10-19T18:46:26.569Z"
    },
    {
      "id": "q-cs-3",
      "createdBy": "usr-teacher-1",
      "questionText": "Dijkstra’s shortest-path algorithm always produces optimal results on directed graphs containing negative-weight edges.",
      "questionType": "true_false",
      "subject": "Computer Science",
      "topic": "Graph Algorithms",
      "category": "Algorithms",
      "difficulty": "easy",
      "options": [
        {
          "id": "true",
          "text": "True"
        },
        {
          "id": "false",
          "text": "False"
        }
      ],
      "correctAnswer": "false",
      "marks": 2,
      "negativeMarks": 0.5,
      "explanation": "Greedy relaxation fails with negative weights; Bellman-Ford handles negative edges safely.",
      "createdAt": "2026-10-22T18:46:26.569Z",
      "updatedAt": "2026-10-22T18:46:26.569Z"
    },
    {
      "id": "q-cs-4",
      "createdBy": "usr-teacher-1",
      "questionText": "Briefly explain why bcrypt is preferred over SHA-256 for storing user passwords in a database.",
      "questionType": "short_answer",
      "subject": "Computer Science",
      "topic": "Cryptography",
      "category": "Application Security",
      "difficulty": "medium",
      "options": [],
      "correctAnswer": "bcrypt is intentionally slow with configurable work factor and built-in per-password salt, resisting brute-force and rainbow table attacks.",
      "marks": 5,
      "negativeMarks": 0,
      "explanation": "Key points: adaptive cost factor (key stretching), automatic salting, resistance to GPU brute-forcing.",
      "createdAt": "2026-10-23T18:46:26.569Z",
      "updatedAt": "2026-10-23T18:46:26.569Z"
    },
    {
      "id": "q-cs-5",
      "createdBy": "usr-teacher-1",
      "questionText": "Design a concurrency-safe submission protocol for an online examination server that prevents duplicate final submissions when a student clicks Submit twice simultaneously.",
      "questionType": "long_answer",
      "subject": "Computer Science",
      "topic": "Distributed Systems",
      "category": "System Design",
      "difficulty": "hard",
      "options": [],
      "correctAnswer": "Use atomic conditional update or unique database index + distributed lock checking status == in_progress within a transaction, returning idempotent response on retries.",
      "marks": 8,
      "negativeMarks": 0,
      "explanation": "Award full credit for atomic compare-and-swap / transaction isolation, unique constraint on attemptId in Result, and server-side deadline validation.",
      "createdAt": "2026-10-24T18:46:26.569Z",
      "updatedAt": "2026-10-24T18:46:26.569Z"
    },
    {
